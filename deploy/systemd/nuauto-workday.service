[Unit]
Description=NUauto: Workday statuses (read-only sign-ins; clear rejections marked Rejected; Discord)

[Service]
Type=oneshot
WorkingDirectory=%h/projects/auto
Environment=TZ=America/New_York
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/auto/.venv/bin/nuauto workday auto
TimeoutStartSec=1h
Nice=10
