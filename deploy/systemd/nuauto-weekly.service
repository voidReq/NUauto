[Unit]
Description=NUauto: weekly check-in (Discord)

[Service]
Type=oneshot
WorkingDirectory=%h/projects/auto
Environment=TZ=America/New_York
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/auto/.venv/bin/python %h/projects/auto/daily.py weekly
TimeoutStartSec=10m
Nice=10
